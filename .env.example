# Skopiuj do .env i zmień w razie potrzeby (docker compose czyta .env automatycznie).

# Model językowy (Ollama). Większy = lepsze wyniki, wolniej: SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0, SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M
LLM_MODEL=SpeakLeash/bielik-1.5b-v3.0-instruct:Q8_0

# Gdzie działa model. Domyślnie Ollama w kontenerze.
# Ollama zainstalowana w Windows (model już pobrany, karta graficzna):  LLM_URL=http://host.docker.internal:11434
#   i uruchamiaj bez kontenera Ollamy:  docker compose up -d --build --no-deps riskminer
LLM_URL=http://ollama:11434

# Risk Miner: ollama | none (same reguły, bez modelu) | openai (API zgodne z OpenAI – podaj klucz)
RISKMINER_LLM_PROVIDER=ollama
RISKMINER_LLM_API_KEY=

# Porty na komputerze
RISKMINER_PORT=8000

# Dane wejściowe (względem folderu repozytorium)
BZP_KOPIA_DIR=../risk_miner_bzp_kopia
MATERIALY_DIR=../Risk_Miner_materialy_dla_uczestnikow_na_start
